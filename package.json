{
  "name": "forge-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Forge UI - Design System & Component Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "build:tokens": "tsc -p packages/tokens/tsconfig.json",
    "build:css": "tsx packages/css/src/build.ts",
    "build:tailwind": "tsc -p packages/tailwind/tsconfig.json",
    "build:variants": "npm run build -w packages/variants",
    "build:react": "npm run build -w packages/react",
    "build:vue": "npm run build -w packages/vue",
    "build:core": "npm run build:tokens && npm run build:css && npm run build:tailwind && npm run build:variants",
    "build:all": "npm run build:core && npm run build:react && npm run build:vue"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^26.0.1",
    "husky": "^9.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
